{
  "hosting": {
    "public": "../Downloads/kiosk project-react welcome/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "projects": {
    "default": "faithpod-kiosk-testing"
  }
}
